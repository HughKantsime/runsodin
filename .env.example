# O.D.I.N. — Environment Configuration
# Copy to .env: cp .env.example .env

# Leave blank to auto-generate on first run (recommended)
ENCRYPTION_KEY=
JWT_SECRET_KEY=
API_KEY=
TRUSTED_HOSTS=localhost,127.0.0.1
TZ=America/New_York

# Native iOS push (APNs). Keep private key material outside the repository.
# Required: Apple key ID, Apple team ID, and one signing-key source.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
# Alternative to APNS_KEY_PATH: inject APNS_KEY_CONTENT through your environment.
APNS_KEY_CONTENT=
# Must match the installed app; ODIN iOS uses this bundle ID.
APNS_BUNDLE_ID=com.jlls.odin
