{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runsodin.com/schemas/release-control-result-v1.json",
  "title": "ODIN release-control gate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate_id", "status", "command", "working_directory",
    "started_at", "ended_at", "duration_seconds", "exit_code", "timed_out",
    "counts", "tool_versions", "log", "artifacts", "findings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "gate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"},
    "status": {"enum": ["pass", "fail"]},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "working_directory": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "passed", "failures", "errors", "skipped", "xfailed"],
      "properties": {
        "tests": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "xfailed": {"type": "integer", "minimum": 0}
      }
    },
    "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sanitized"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sanitized": {"const": true}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "string"}}
  }
}
