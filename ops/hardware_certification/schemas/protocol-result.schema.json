{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "git_commit", "mode", "protocol", "certification_level", "status", "started_at", "ended_at", "assertion_counts", "metrics", "assertions"],
  "properties": {
    "schema_version": {"const": 1}, "run_id": {"type": "string"}, "git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "mode": {"enum": ["replay", "observe", "exercise"]}, "protocol": {"enum": ["bambu", "elegoo", "moonraker", "prusalink"]},
    "certification_level": {"enum": ["simulated_replay", "live_passive_observation", "live_authorized_exercise"]}, "status": {"enum": ["pass", "fail", "blocked"]},
    "started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"},
    "authorization_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_scope": {"type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "protocol", "actions", "expires_at", "model_family", "target_correlation_sha256"], "properties": {"schema_version": {"const": 1}, "run_id": {"type": "string"}, "protocol": {"enum": ["bambu", "elegoo", "moonraker", "prusalink"]}, "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["upload", "start", "upload_start", "pause", "resume", "stop", "cancel", "ams_read"]}}, "expires_at": {"type": "string", "format": "date-time"}, "model_family": {"type": "string", "minLength": 1, "maxLength": 64}, "target_correlation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "requested_actions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["upload", "start", "upload_start", "pause", "resume", "stop", "cancel", "ams_read"]}},
    "executed_actions": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["upload", "start", "upload_start", "pause", "resume", "stop", "cancel", "ams_read"]}},
    "assertion_counts": {"type": "object", "additionalProperties": false, "required": ["executed", "passed", "failed", "blocked", "skipped", "xfailed"], "properties": {"executed": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "blocked": {"type": "integer", "minimum": 0}, "skipped": {"const": 0}, "xfailed": {"const": 0}}},
    "metrics": {"type": "object", "additionalProperties": false, "properties": {"valid_sample_count": {"type": "integer", "minimum": 0}, "freshness_seconds": {"type": "number", "minimum": 0}, "reconnect_count": {"type": "integer", "minimum": 0, "maximum": 1}, "model_family": {"type": "string", "maxLength": 64}, "firmware_version": {"type": "string", "maxLength": 64}, "api_version": {"type": "string", "maxLength": 64}, "target_correlation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_-]{1,40}$"}}}},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "reason_code", "duration_ms"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}, "status": {"enum": ["pass", "fail", "blocked"]}, "reason_code": {"enum": ["action_failed", "capability_shape_invalid", "configured_model_bound", "insufficient_samples", "malformed_or_unavailable", "malformed_telemetry", "mapped", "model_family_mismatch", "model_identity_unavailable", "target_identity_mismatch", "device_version_mismatch", "observed", "passive_protocol_rejected", "passive_samples_unavailable", "passive_transport_unavailable", "payload_size_invalid", "read_only", "sample_freshness_invalid", "strict_suite_failed", "strict_suite_passed", "transition_observed", "unexpected_failure", "unsupported_protocol"]}, "duration_ms": {"type": "number", "minimum": 0}}}}
  },
  "allOf": [
    {"if": {"properties": {"protocol": {"const": "bambu"}}, "required": ["protocol"]}, "then": {"properties": {"requested_actions": {"items": {"enum": ["upload", "start", "pause", "resume", "stop", "ams_read"]}}, "executed_actions": {"items": {"enum": ["upload", "start", "pause", "resume", "stop", "ams_read"]}}}}},
    {"if": {"properties": {"protocol": {"const": "elegoo"}}, "required": ["protocol"]}, "then": {"properties": {"requested_actions": {"items": {"enum": ["pause", "resume", "stop"]}}, "executed_actions": {"items": {"enum": ["pause", "resume", "stop"]}}}}},
    {"if": {"properties": {"protocol": {"const": "moonraker"}}, "required": ["protocol"]}, "then": {"properties": {"requested_actions": {"items": {"enum": ["upload", "start", "pause", "resume", "cancel"]}}, "executed_actions": {"items": {"enum": ["upload", "start", "pause", "resume", "cancel"]}}}}},
    {"if": {"properties": {"protocol": {"const": "prusalink"}}, "required": ["protocol"]}, "then": {"properties": {"requested_actions": {"items": {"enum": ["upload_start", "pause", "resume", "stop"]}}, "executed_actions": {"items": {"enum": ["upload_start", "pause", "resume", "stop"]}}}}},
    {"if": {"properties": {"mode": {"const": "exercise"}}, "required": ["mode"]}, "then": {"required": ["authorization_scope", "authorization_scope_sha256", "requested_actions", "executed_actions"], "properties": {"certification_level": {"const": "live_authorized_exercise"}, "metrics": {"required": ["model_family", "target_correlation_sha256"]}}}, "else": {"not": {"anyOf": [{"required": ["authorization_scope"]}, {"required": ["authorization_scope_sha256"]}, {"required": ["requested_actions"]}, {"required": ["executed_actions"]}]}}},
    {"if": {"properties": {"mode": {"const": "observe"}}}, "then": {"properties": {"certification_level": {"const": "live_passive_observation"}, "metrics": {"required": ["valid_sample_count", "freshness_seconds", "reconnect_count", "model_family", "target_correlation_sha256", "capabilities"]}}}},
    {"if": {"properties": {"mode": {"const": "replay"}}}, "then": {"properties": {"certification_level": {"const": "simulated_replay"}}}},
    {"if": {"properties": {"mode": {"const": "observe"}, "status": {"const": "pass"}}, "required": ["mode", "status"]}, "then": {"properties": {"metrics": {"properties": {"valid_sample_count": {"minimum": 2}, "freshness_seconds": {"exclusiveMinimum": 0, "maximum": 30}, "model_family": {"minLength": 1}, "capabilities": {"minItems": 1}}}}}}
  ]
}
