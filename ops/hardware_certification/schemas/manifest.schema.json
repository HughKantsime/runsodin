{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "git_commit", "git_dirty", "mode", "protocol", "status", "started_at", "ended_at", "duration_seconds", "junit", "implementation_sha256", "sanitizer_passed", "result_references", "files"],
  "properties": {
    "schema_version": {"const": 1}, "run_id": {"type": "string"}, "git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}, "git_dirty": {"type": "boolean"},
    "mode": {"enum": ["replay", "observe", "exercise"]}, "protocol": {"enum": ["bambu", "elegoo", "moonraker", "prusalink", "all"]}, "status": {"enum": ["pass", "fail", "blocked"]},
    "started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"}, "duration_seconds": {"type": "number", "minimum": 0, "maximum": 3600}, "sanitizer_passed": {"type": "boolean"},
    "junit": {"type": "object", "additionalProperties": false, "required": ["tests", "failures", "errors", "skipped", "xfailed"], "properties": {"tests": {"type": "integer", "minimum": 1}, "failures": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}, "skipped": {"const": 0}, "xfailed": {"const": 0}}},
    "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "simulator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_references": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["bambu.json", "elegoo.json", "moonraker.json", "prusalink.json"]}},
    "authorization_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_scope": {"type": "object", "additionalProperties": false, "required": ["schema_version", "run_id", "protocol", "actions", "expires_at", "model_family", "target_correlation_sha256"], "properties": {"schema_version": {"const": 1}, "run_id": {"type": "string"}, "protocol": {"enum": ["bambu", "elegoo", "moonraker", "prusalink"]}, "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["upload", "start", "upload_start", "pause", "resume", "stop", "cancel", "ams_read"]}}, "expires_at": {"type": "string", "format": "date-time"}, "model_family": {"type": "string", "minLength": 1, "maxLength": 64}, "target_correlation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "requested_actions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["upload", "start", "upload_start", "pause", "resume", "stop", "cancel", "ams_read"]}},
    "executed_actions": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["upload", "start", "upload_start", "pause", "resume", "stop", "cancel", "ams_read"]}}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "replay"}}, "required": ["mode"]},
      "then": {"required": ["fixture_sha256", "simulator_sha256"], "properties": {"protocol": {"const": "all"}, "result_references": {"const": ["bambu.json", "elegoo.json", "moonraker.json", "prusalink.json"]}}}
    },
    {
      "if": {"properties": {"protocol": {"const": "bambu"}}, "required": ["protocol"]},
      "then": {"properties": {"result_references": {"const": ["bambu.json"]}}}
    },
    {
      "if": {"properties": {"protocol": {"const": "elegoo"}}, "required": ["protocol"]},
      "then": {"properties": {"result_references": {"const": ["elegoo.json"]}}}
    },
    {
      "if": {"properties": {"protocol": {"const": "moonraker"}}, "required": ["protocol"]},
      "then": {"properties": {"result_references": {"const": ["moonraker.json"]}}}
    },
    {
      "if": {"properties": {"protocol": {"const": "prusalink"}}, "required": ["protocol"]},
      "then": {"properties": {"result_references": {"const": ["prusalink.json"]}}}
    },
    {"if": {"properties": {"mode": {"const": "exercise"}}, "required": ["mode"]}, "then": {"required": ["authorization_scope", "authorization_scope_sha256", "requested_actions", "executed_actions"]}, "else": {"not": {"anyOf": [{"required": ["authorization_scope"]}, {"required": ["authorization_scope_sha256"]}, {"required": ["requested_actions"]}, {"required": ["executed_actions"]}]}}},
    {"if": {"properties": {"status": {"const": "pass"}}}, "then": {"properties": {"junit": {"properties": {"failures": {"const": 0}, "errors": {"const": 0}}}}}}
  ]
}
