# Copy to ops/demo/.env (gitignored) and fill in. NEVER share these
# with the prod ODIN env — the demo stack must use a fresh keypair so
# a leak from the demo origin can never decrypt prod data.

# Required — Fernet key. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ODIN_DEMO_ENCRYPTION_KEY=

# Required — JWT signing secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ODIN_DEMO_JWT_SECRET_KEY=

# Optional — frontend-to-backend API key. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ODIN_DEMO_API_KEY=

# Required — host LAN IP for go2rtc ICE candidates (compose host).
ODIN_DEMO_HOST_IP=

# Required — public URL the demo origin is served at.
ODIN_DEMO_PUBLIC_URL=https://demo.subsystem.app

# Optional — pin to a specific image tag for reproducible reviewer envs.
# Defaults to ghcr.io/hughkantsime/odin:latest in compose.
# ODIN_DEMO_IMAGE=ghcr.io/hughkantsime/odin:v1.9.4

# Optional — host-port overrides. Required if co-locating on the M4 with
# prod ODIN (which already binds 8000 / 8555). VPS deploys can leave
# these unset.
#   ODIN_DEMO_HTTP_PORT=8001
#   ODIN_DEMO_WEBRTC_PORT=8556

# Optional
TZ=UTC

# EDU overlay only — all values are required by `demo-edu-up` and
# `demo-edu-reset`. Keep the signed artifact outside odin-demo-data so a reset
# cannot erase it. The file is signature-checked before the stack is changed.
# ODIN_DEMO_LICENSE_FILE=/absolute/path/to/odin-education.license
# ODIN_DEMO_EDU_ADMIN_EMAIL=edu-admin@example.edu
# ODIN_DEMO_EDU_ADMIN_PASSWORD=
# ODIN_DEMO_EDU_TEACHER_EMAIL=teacher@example.edu
# ODIN_DEMO_EDU_TEACHER_PASSWORD=
# ODIN_DEMO_EDU_STUDENT_EMAIL=student@example.edu
# ODIN_DEMO_EDU_STUDENT_PASSWORD=

# Optional App Review persona in the EDU sandbox. Set both or neither.
# ODIN_DEMO_REVIEWER_EMAIL=appreview@demo.subsystem.app
# ODIN_DEMO_REVIEWER_PASSWORD=
